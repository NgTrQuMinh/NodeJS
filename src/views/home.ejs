<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/reaset.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <div class="topnav">
        <a class="active" href="/">Home</a>
        <a href="/create">Create Users</a>
        <a href="/">Contact</a>
        <a href="/">About</a>
    </div>

    <div class="table-container">
        <!-- <%= JSON.stringify(listUsers) %>  -->
        <!-- Thanh công cụ phía trên -->
        <div class="table-header">
            <h2>Danh Sách Khách Hàng</h2>
            <button class="btn btn-create">
                <i class="fas fa-plus"></i> <a href="/create">Thêm mới</a>
            </button>
        </div>

        <!-- Bảng dữ liệu CRUD (Email, Name, City) -->
        <table class="crud-table">
            <thead>
                <tr>
                    <th>Họ và Tên</th>
                    <th>Email</th>
                    <th>Thành phố</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                <!-- Sử dụng vòng lặp for...each của JavaScript -->
                <% listUsers.forEach(function(item, index) { %>
                    <tr>
                        <td><strong>
                                <%= item.name %>
                            </strong></td>
                        <td>
                            <%= item.email %>
                        </td>
                        <td>
                            <%= item.city %>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button class="btn-action btn-edit" title="Sửa"><i class="fas fa-edit"></i> Sửa</button>
                                <button class="btn-action btn-delete" title="Xóa"><i class="fas fa-trash"></i>
                                    Xóa</button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                        <!-- Sử dụng vòng lặp for...of của JavaScript -->
                        <!-- <% for (let item of listUsers) { %>
                            <tr>
                                <td><strong>
                                        <%= item.name %>
                                    </strong></td>
                                <td>
                                    <%= item.email %>
                                </td>
                                <td>
                                    <%= item.city %>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-action btn-edit" title="Sửa" data-id="<%= item.id %>">
                                            <i class="fas fa-edit"></i> Sửa
                                        </button>
                                        <button class="btn-action btn-delete" title="Xóa" data-id="<%= item.id %>">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% } %> -->
            </tbody>


        </table>
    </div>

    <!-- Nhúng thư viện FontAwesome để hiển thị icon (Copy bỏ vào thẻ <head>) -->
    <link rel="stylesheet" href="https://cloudflare.com">


</body>

</html>